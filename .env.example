# Database connection (SQLite default for seamless local demo, or MySQL: mysql://user:password@localhost:3306/spp_db)
DATABASE_URL="file:./dev.db"

# Session JWT Secret (minimum 32 characters)
SESSION_SECRET="super-secret-session-key-min-32-chars-long-12345"

# Shared Payment Gateway Webhook HMAC Secret
PG_SECRET="secret-payment-gateway-hmac-key-2026"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Virtual Account Configuration
VA_PREFIX="88000"
